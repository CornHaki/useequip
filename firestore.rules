rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function activeAccount() {
      return signedIn() && profile(request.auth.uid).get('active', true) == true;
    }

    function hasUserRole(account) {
      return account.get('role', '') == 'user';
    }

    function hasAdminRole(account) {
      return account.get('role', '') == 'admin';
    }

    function isOwner(ownerUid) {
      return activeAccount()
        && hasAdminRole(profile(request.auth.uid))
        && ownerUid == request.auth.uid;
    }

    function resourcePath(resourceId) {
      return /databases/$(database)/documents/resources/$(resourceId);
    }

    function normalizedCategory(resource) {
      let categoryId = resource.get('categoryId', resource.get('category', ''));
      return categoryId in ['3D Printing & Makerspace', '3D Printing and Makerspace']
        ? '3d_printing_makerspace'
        : categoryId in ['Cameras & Media', 'Camera and Media'] ? 'camera_media'
        : categoryId in ['Drones & Robotics', 'Drones and Robotics'] ? 'drones_robotics'
        : categoryId == 'Lab Instruments' ? 'lab_instruments'
        : categoryId == 'Electronics and Electrical' ? 'electronics_electrical'
        : categoryId == 'Mechanical and Workshop Tools' ? 'mechanical_workshop_tools'
        : categoryId == 'Computing and Emerging Technology' ? 'computing_emerging_technology'
        : categoryId == 'Scientific and Environmental Equipment' ? 'scientific_environmental_equipment'
        : categoryId == 'Safety and Protective Equipment' ? 'safety_protective_equipment'
        : categoryId in ['Other', 'Other / Miscellaneous'] ? 'other_miscellaneous'
        : categoryId in [
          '3d_printing_makerspace', 'camera_media', 'drones_robotics',
          'lab_instruments', 'electronics_electrical', 'mechanical_workshop_tools',
          'computing_emerging_technology', 'scientific_environmental_equipment',
          'safety_protective_equipment', 'other_miscellaneous'
        ] ? categoryId
        : 'other_miscellaneous';
    }

    function effectiveQualificationType(resource) {
      let configuredType = resource.get('qualificationType', '');
      return configuredType == ''
        ? (resource.get('requirements', []).size() > 0 ? 'training_proof' : 'none')
        : configuredType == 'none' && resource.get('trainingRequired', false) == true
          ? 'training_proof'
          : configuredType;
    }

    function validQualificationSubmission(resource, submissionType) {
      return (
        effectiveQualificationType(resource) == 'official_certificate'
        && submissionType == 'certificate'
      ) || (
        effectiveQualificationType(resource) == 'training_proof'
        && submissionType == 'training'
      ) || (
        effectiveQualificationType(resource) == 'practical_assessment'
        && (
          submissionType in ['experience', 'assessment']
          || (
            resource.get('trainingRequired', false) == true
            && submissionType == 'training'
          )
        )
      );
    }

    function qualificationPath(qualificationId) {
      return /databases/$(database)/documents/qualifications/$(qualificationId);
    }

    function qualificationGrantPath(qualificationId, resourceId) {
      return /databases/$(database)/documents/qualificationGrants/$(qualificationId + '_' + resourceId);
    }

    function qualificationEvidencePath(qualificationId) {
      return /databases/$(database)/documents/qualificationEvidence/$(qualificationId);
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function auditPath(auditId) {
      return /databases/$(database)/documents/auditLogs/$(auditId);
    }

    function hasAuditAfter(relatedId, relatedType, actionLabel, ownerUid) {
      let audit = getAfter(auditPath(relatedId + '_' + actionLabel)).data;
      return audit.actorUid == request.auth.uid
        && audit.relatedId == relatedId
        && audit.relatedType == relatedType
        && audit.actionLabel == actionLabel
        && audit.ownerUid == ownerUid;
    }

    function validBookingAudit(bookingId, actionLabel) {
      let booking = getAfter(bookingPath(bookingId)).data;
      return (
        actionLabel == 'Booking Requested'
        && booking.userId == request.auth.uid
        && booking.status in ['Requested', 'Waitlisted']
        && booking.createdAt == request.time
      ) || (
        actionLabel == 'Booking Cancelled'
        && booking.userId == request.auth.uid
        && booking.status == 'Cancelled'
        && booking.cancelledByUid == request.auth.uid
      ) || (
        actionLabel == 'Request Cleared'
        && booking.userId == request.auth.uid
        && booking.status in ['Rejected', 'Completed']
        && booking.clearedByUserAt == request.time
      ) || (
        actionLabel == 'Request Approved'
        && booking.ownerUid == request.auth.uid
        && booking.status == 'Approved'
        && booking.decisionAt == request.time
      ) || (
        actionLabel == 'Request Waitlisted'
        && booking.ownerUid == request.auth.uid
        && booking.status == 'Waitlisted'
        && booking.decisionAt == request.time
      ) || (
        actionLabel == 'Request Declined'
        && booking.ownerUid == request.auth.uid
        && booking.status == 'Rejected'
        && booking.decisionAt == request.time
      ) || (
        actionLabel == 'Equipment Picked Up'
        && booking.userId == request.auth.uid
        && booking.status == 'Checked-Out'
        && booking.checkInData.timestamp == request.time
      ) || (
        actionLabel == 'Equipment Returned'
        && booking.userId == request.auth.uid
        && booking.status == 'Returned'
        && booking.checkOutData.timestamp == request.time
      ) || (
        actionLabel == 'Return Inspected and Booking Completed'
        && booking.ownerUid == request.auth.uid
        && booking.status == 'Completed'
        && booking.returnCondition.inspectedAt == request.time
      );
    }

    function validQualificationAudit(qualificationId, actionLabel) {
      let qualification = getAfter(qualificationPath(qualificationId)).data;
      return (
        actionLabel == 'Qualification Submitted'
        && qualification.userId == request.auth.uid
        && qualification.status == 'Pending'
        && qualification.createdAt == request.time
      ) || (
        actionLabel == 'Qualification Verified'
        && qualification.ownerUid == request.auth.uid
        && qualification.status == 'Verified'
        && qualification.verifiedAt == request.time
      ) || (
        actionLabel == 'Qualification Rejected'
        && qualification.ownerUid == request.auth.uid
        && qualification.status == 'Rejected'
        && qualification.updatedAt == request.time
      ) || (
        actionLabel == 'Qualification Revoked'
        && qualification.ownerUid == request.auth.uid
        && qualification.status == 'Revoked'
        && qualification.updatedAt == request.time
      ) || (
        actionLabel == 'Qualification Expired'
        && qualification.ownerUid == request.auth.uid
        && qualification.status == 'Expired'
        && qualification.updatedAt == request.time
      ) || (
        actionLabel == 'Practical Assessment Scheduled'
        && qualification.ownerUid == request.auth.uid
        && qualification.status == 'Pending'
        && qualification.assessmentStatus == 'Scheduled'
        && qualification.updatedAt == request.time
      ) || (
        actionLabel == 'Practical Assessment Passed'
        && qualification.ownerUid == request.auth.uid
        && qualification.status == 'Verified'
        && qualification.assessmentStatus == 'Passed'
        && qualification.verifiedAt == request.time
      ) || (
        actionLabel == 'Practical Assessment Failed'
        && qualification.ownerUid == request.auth.uid
        && qualification.status == 'Rejected'
        && qualification.assessmentStatus == 'Failed'
        && qualification.updatedAt == request.time
      ) || (
        actionLabel == 'Training Required'
        && qualification.ownerUid == request.auth.uid
        && qualification.status == 'Training Required'
        && qualification.assessmentStatus == 'Training Required'
        && qualification.updatedAt == request.time
      );
    }

    function validQualificationGrantAudit(grantId) {
      let grant = getAfter(
        /databases/$(database)/documents/qualificationGrants/$(grantId)
      ).data;
      return grant.ownerUid == request.auth.uid
        && grant.active == true
        && grant.createdAt == request.time;
    }

    function validBookingQualification(booking, equipment) {
      return (
        effectiveQualificationType(equipment) == 'none'
        && booking.get('qualificationId', null) == null
        && booking.get('supervisedAccess', false) == false
      ) || (
        booking.get('supervisedAccess', false) == true
        && equipment.get('supervisedUseAllowed', false) == true
        && booking.get('qualificationId', null) == null
      ) || (
        booking.get('supervisedAccess', false) == false
        && booking.get('qualificationId', null) is string
        && verifiedQualificationForBooking(booking, equipment)
      );
    }

    function verifiedQualificationForBooking(booking, equipment) {
      let qualificationId = booking.qualificationId;
      let qualification = get(qualificationPath(qualificationId)).data;
      return qualification.userId == booking.userId
        && qualification.ownerUid == booking.ownerUid
        && qualification.qualificationType == effectiveQualificationType(equipment)
        && qualification.categoryId == normalizedCategory(equipment)
        && qualification.status == 'Verified'
        && (
          qualification.expiresAt == null
          || qualification.expiresAt > request.time
        )
        && (
          qualification.equipmentId == booking.resourceId
          || validQualificationGrantForBooking(booking, qualificationId)
        );
    }

    function validQualificationGrantForBooking(booking, qualificationId) {
      let grant = get(qualificationGrantPath(qualificationId, booking.resourceId)).data;
      return grant.qualificationId == qualificationId
        && grant.resourceId == booking.resourceId
        && grant.userId == booking.userId
        && grant.ownerUid == booking.ownerUid
        && grant.active == true;
    }

    function validReportAudit(reportId, actionLabel) {
      let report = getAfter(
        /databases/$(database)/documents/equipmentReports/$(reportId)
      ).data;
      return (
        actionLabel == 'Equipment Report Submitted'
        && report.userId == request.auth.uid
        && report.status == 'Pending'
        && report.createdAt == request.time
      ) || (
        actionLabel == 'Equipment Report Updated to ' + report.status
        && report.ownerUid == request.auth.uid
        && report.status in ['Under Review', 'Resolved', 'Rejected']
        && report.updatedAt == request.time
      );
    }

    function bookingResourceIsReserved(bookingId, resourceId) {
      return getAfter(resourcePath(resourceId)).data.get('reservedByBookingId', null) == bookingId;
    }

    function resourceReservationReleased(bookingId, resourceId) {
      return getAfter(resourcePath(resourceId)).data.get('reservedByBookingId', null) == null
        && getAfter(bookingPath(bookingId)).data.status in ['Cancelled', 'Completed'];
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['user', 'admin']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.get('active', true) == true
        && request.resource.data.get('contactPhone', '').size() <= 40
        && request.resource.data.get('department', '').size() <= 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'role', 'active', 'contactPhone',
          'department', 'activeBookings', 'createdAt'
        ]);

      allow update: if false;
      allow delete: if false;
    }

    match /resources/{resourceId} {
      allow read: if activeAccount();

      allow create: if activeAccount()
        && hasAdminRole(profile(request.auth.uid))
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName == profile(request.auth.uid).name
        && request.resource.data.ownerName is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.categoryId is string
        && request.resource.data.location is string
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 250000
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.subcategory is string
        && request.resource.data.subcategory.size() <= 120
        && request.resource.data.qualificationType in [
          'official_certificate', 'training_proof', 'practical_assessment', 'none'
        ]
        && request.resource.data.qualificationInstructions is string
        && request.resource.data.qualificationInstructions.size() <= 1200
        && request.resource.data.trainingRequired is bool
        && request.resource.data.supervisedUseAllowed is bool
        && request.resource.data.qualificationReusable is bool
        && request.resource.data.safetyInstructions is string
        && request.resource.data.safetyInstructions.size() <= 2000
        && request.resource.data.status == 'Available'
        && request.resource.data.get('reservedByBookingId', null) == null
        && request.resource.data.archived == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'name', 'category', 'location', 'imageData', 'requirements',
          'checklist', 'usageRules', 'specs', 'status', 'ownerUid',
          'ownerName', 'department', 'archived', 'createdAt', 'updatedAt',
          'categoryId', 'description', 'subcategory', 'qualificationType',
          'qualificationInstructions', 'trainingRequired', 'supervisedUseAllowed',
          'qualificationReusable', 'safetyInstructions'
        ]);

      allow update: if (
        isOwner(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.categoryId is string
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.subcategory is string
        && request.resource.data.subcategory.size() <= 120
        && request.resource.data.qualificationType in [
          'official_certificate', 'training_proof', 'practical_assessment', 'none'
        ]
        && request.resource.data.qualificationInstructions is string
        && request.resource.data.qualificationInstructions.size() <= 1200
        && request.resource.data.trainingRequired is bool
        && request.resource.data.supervisedUseAllowed is bool
        && request.resource.data.qualificationReusable is bool
        && request.resource.data.safetyInstructions is string
        && request.resource.data.safetyInstructions.size() <= 2000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'category', 'categoryId', 'location', 'imageData', 'requirements', 'checklist',
          'description', 'subcategory', 'qualificationType', 'qualificationInstructions',
          'trainingRequired', 'supervisedUseAllowed', 'qualificationReusable', 'safetyInstructions',
          'usageRules', 'updatedAt', 'status', 'archived', 'archivedAt',
          'archivedByUid', 'reservedByBookingId'
        ])
        && (
          !request.resource.data.keys().hasAny(['imageData'])
          || (
            request.resource.data.imageData is string
            && request.resource.data.imageData.size() <= 250000
          )
        )
        && (
          resource.data.get('reservedByBookingId', null) == null
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'reservedByBookingId'
          ])
        )
        && (
          request.resource.data.get('reservedByBookingId', null)
            == resource.data.get('reservedByBookingId', null)
          || (
            resource.data.get('reservedByBookingId', null) == null
            && request.resource.data.get('reservedByBookingId', null) is string
            && getAfter(bookingPath(request.resource.data.reservedByBookingId)).data.status == 'Approved'
            && getAfter(bookingPath(request.resource.data.reservedByBookingId)).data.resourceId == resourceId
          )
          || (
            request.resource.data.get('reservedByBookingId', null) == null
            && resource.data.get('reservedByBookingId', null) is string
            && resourceReservationReleased(resource.data.reservedByBookingId, resourceId)
          )
        )
        && (
          request.resource.data.status == resource.data.status
          || (
            request.resource.data.status in ['Available', 'Maintenance']
            && resource.data.get('reservedByBookingId', null) == null
          )
          || (
            request.resource.data.status == 'In Use'
            && resource.data.get('reservedByBookingId', null) is string
            && getAfter(bookingPath(resource.data.reservedByBookingId)).data.status == 'Checked-Out'
          )
          || (
            request.resource.data.status in ['Available', 'Maintenance']
            && resource.data.get('reservedByBookingId', null) is string
            && resourceReservationReleased(resource.data.reservedByBookingId, resourceId)
          )
        )
      ) || (
        activeAccount()
        && resource.data.status == 'Available'
        && request.resource.data.status == 'In Use'
        && resource.data.get('reservedByBookingId', null) is string
        && request.resource.data.get('reservedByBookingId', null)
          == resource.data.reservedByBookingId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && getAfter(bookingPath(resource.data.reservedByBookingId)).data.userId == request.auth.uid
        && getAfter(bookingPath(resource.data.reservedByBookingId)).data.status == 'Checked-Out'
        && getAfter(bookingPath(resource.data.reservedByBookingId)).data.resourceId == resourceId
      ) || (
        activeAccount()
        && resource.data.status == 'Available'
        && request.resource.data.status == 'Available'
        && resource.data.get('reservedByBookingId', null) is string
        && request.resource.data.get('reservedByBookingId', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'reservedByBookingId'
        ])
        && resourceReservationReleased(resource.data.reservedByBookingId, resourceId)
        && getAfter(bookingPath(resource.data.reservedByBookingId)).data.userId == request.auth.uid
        && getAfter(bookingPath(resource.data.reservedByBookingId)).data.ownerUid
          == resource.data.ownerUid
        && getAfter(bookingPath(resource.data.reservedByBookingId)).data.resourceId == resourceId
      );

      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if activeAccount()
        && (resource.data.userId == request.auth.uid
          || isOwner(resource.data.ownerUid));

      allow create: if activeAccount()
        && hasUserRole(profile(request.auth.uid))
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['Requested', 'Waitlisted']
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.resourceId is string
        && request.resource.data.userName == profile(request.auth.uid).name
        && get(resourcePath(request.resource.data.resourceId)).data.ownerUid
          == request.resource.data.ownerUid
        && get(resourcePath(request.resource.data.resourceId)).data.name
          == request.resource.data.resourceName
        && get(resourcePath(request.resource.data.resourceId)).data.get('archived', false) == false
        && validBookingQualification(
          request.resource.data,
          get(resourcePath(request.resource.data.resourceId)).data
        )
        && request.resource.data.status == (
          get(resourcePath(request.resource.data.resourceId)).data.status == 'Available'
          && get(resourcePath(request.resource.data.resourceId)).data.get('reservedByBookingId', null) == null
            ? 'Requested'
            : 'Waitlisted'
        )
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() > 0
        && request.resource.data.purpose.size() <= 2000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'resourceId', 'resourceName', 'ownerUid', 'userId', 'userName',
          'dateSlot', 'purpose', 'certificateName', 'status', 'createdAt',
          'updatedAt', 'checkInData', 'checkOutData', 'returnCondition',
          'clearedByUserAt', 'qualificationId', 'supervisedAccess'
        ])
        && hasAuditAfter(
          bookingId,
          'booking',
          'Booking Requested',
          request.resource.data.ownerUid
        );

      allow update: if activeAccount()
        && (
          (
            resource.data.userId == request.auth.uid
            && request.resource.data.status == 'Cancelled'
            && resource.data.status in ['Requested', 'Waitlisted', 'Approved']
            && request.resource.data.cancellationReason is string
            && request.resource.data.cancellationReason.size() > 0
            && request.resource.data.cancellationReason.size() <= 1000
            && request.resource.data.cancelledByUid == request.auth.uid
            && request.resource.data.cancelledByName == profile(request.auth.uid).name
            && request.resource.data.cancelledAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'cancellationReason', 'cancelledAt', 'cancelledByUid',
              'cancelledByName', 'updatedAt'
            ])
            && (
              resource.data.status != 'Approved'
              || resourceReservationReleased(bookingId, resource.data.resourceId)
            )
            && hasAuditAfter(
              bookingId,
              'booking',
              'Booking Cancelled',
              resource.data.ownerUid
            )
          )
          || (
            resource.data.userId == request.auth.uid
            && resource.data.status in ['Rejected', 'Completed']
            && request.resource.data.status == resource.data.status
            && request.resource.data.clearedByUserAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'clearedByUserAt', 'updatedAt'
            ])
            && hasAuditAfter(
              bookingId,
              'booking',
              'Request Cleared',
              resource.data.ownerUid
            )
          )
          || (
            isOwner(resource.data.ownerUid)
            && resource.data.status in ['Requested', 'Waitlisted']
            && request.resource.data.status in ['Approved', 'Waitlisted', 'Rejected']
            && request.resource.data.updatedAt == request.time
            && request.resource.data.decisionAt == request.time
            && request.resource.data.approvedByUid == request.auth.uid
            && request.resource.data.approvedBy == profile(request.auth.uid).name
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'approvedByUid', 'approvedBy', 'decisionAt',
              'rejectionReason', 'updatedAt'
            ])
            && (
              request.resource.data.status != 'Approved'
              || bookingResourceIsReserved(bookingId, resource.data.resourceId)
                && validBookingQualification(
                  request.resource.data,
                  get(resourcePath(resource.data.resourceId)).data
                )
            )
            && (
              request.resource.data.status != 'Rejected'
              || request.resource.data.get('rejectionReason', '').size() > 0
            )
            && hasAuditAfter(
              bookingId,
              'booking',
              request.resource.data.status == 'Rejected'
                ? 'Request Declined'
                : 'Request ' + request.resource.data.status,
              resource.data.ownerUid
            )
          )
          || (
            resource.data.userId == request.auth.uid
            && resource.data.status == 'Approved'
            && request.resource.data.status == 'Checked-Out'
            && request.resource.data.checkInData is map
            && request.resource.data.checkInData.timestamp == request.time
            && request.resource.data.checkInData.photoData.size() > 0
            && request.resource.data.checkInData.photoData.size() <= 250000
            && request.resource.data.checkInData.checklistVerified == true
            && getAfter(resourcePath(resource.data.resourceId)).data.status == 'In Use'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt', 'checkInData'
            ])
            && hasAuditAfter(
              bookingId,
              'booking',
              'Equipment Picked Up',
              resource.data.ownerUid
            )
          )
          || (
            resource.data.userId == request.auth.uid
            && resource.data.status == 'Checked-Out'
            && request.resource.data.status == 'Returned'
            && request.resource.data.checkOutData is map
            && request.resource.data.checkOutData.timestamp == request.time
            && request.resource.data.checkOutData.photoData.size() > 0
            && request.resource.data.checkOutData.photoData.size() <= 250000
            && request.resource.data.checkOutData.checklistVerified == true
            && request.resource.data.returnCondition is map
            && request.resource.data.returnCondition.assessedAt == request.time
            && request.resource.data.returnCondition.assessedByUid == request.auth.uid
            && request.resource.data.returnCondition.borrowerAssessment in [
              'Good', 'Damaged', 'Maintenance'
            ]
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt', 'checkOutData', 'returnCondition',
              'incidentReport'
            ])
            && hasAuditAfter(
              bookingId,
              'booking',
              'Equipment Returned',
              resource.data.ownerUid
            )
          )
          || (
            isOwner(resource.data.ownerUid)
            && resource.data.status == 'Returned'
            && request.resource.data.status == 'Completed'
            && request.resource.data.updatedAt == request.time
            && request.resource.data.returnCondition is map
            && request.resource.data.returnCondition.ownerAssessment in [
              'Good Condition', 'Damaged', 'Maintenance'
            ]
            && request.resource.data.returnCondition.inspectedByUid == request.auth.uid
            && getAfter(resourcePath(resource.data.resourceId))
              .data.get('reservedByBookingId', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt', 'returnCondition'
            ])
            && hasAuditAfter(
              bookingId,
              'booking',
              'Return Inspected and Booking Completed',
              resource.data.ownerUid
            )
          )
        );

      allow delete: if false;
    }

    match /qualifications/{qualificationId} {
      allow read: if activeAccount()
        && (resource.data.userId == request.auth.uid
          || isOwner(resource.data.ownerUid));

      allow create: if activeAccount()
        && hasUserRole(profile(request.auth.uid))
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName == profile(request.auth.uid).name
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.equipmentId is string
        && get(resourcePath(request.resource.data.equipmentId)).data.ownerUid
          == request.resource.data.ownerUid
        && request.resource.data.equipmentName
          == get(resourcePath(request.resource.data.equipmentId)).data.name
        && request.resource.data.categoryId
          == normalizedCategory(get(resourcePath(request.resource.data.equipmentId)).data)
        && request.resource.data.qualificationType
          == effectiveQualificationType(get(resourcePath(request.resource.data.equipmentId)).data)
        && request.resource.data.qualificationType in [
          'official_certificate', 'training_proof', 'practical_assessment'
        ]
        && validQualificationSubmission(
          get(resourcePath(request.resource.data.equipmentId)).data,
          request.resource.data.submissionType
        )
        && (
          request.resource.data.hasEvidence == (request.resource.data.submissionType in ['certificate', 'training'])
        )
        && request.resource.data.hasEvidence is bool
        && request.resource.data.evidenceName is string
        && request.resource.data.evidenceName.size() <= 255
        && request.resource.data.evidenceMimeType in [
          '', 'application/pdf', 'image/jpeg', 'image/png', 'image/webp'
        ]
        && (
          request.resource.data.hasEvidence == false
          || (
            getAfter(qualificationEvidencePath(qualificationId)).data.userId
              == request.resource.data.userId
            && getAfter(qualificationEvidencePath(qualificationId)).data.ownerUid
              == request.resource.data.ownerUid
            && getAfter(qualificationEvidencePath(qualificationId)).data.fileName
              == request.resource.data.evidenceName
            && getAfter(qualificationEvidencePath(qualificationId)).data.mimeType
              == request.resource.data.evidenceMimeType
          )
        )
        && request.resource.data.experienceDetails is string
        && request.resource.data.experienceDetails.size() <= 3000
        && (
          !(request.resource.data.submissionType in ['experience', 'assessment'])
          || request.resource.data.experienceDetails.size() > 0
        )
        && request.resource.data.status == 'Pending'
        && request.resource.data.reviewerNotes == ''
        && request.resource.data.assessmentStatus
          == (request.resource.data.submissionType == 'assessment' ? 'Requested' : 'Not Requested')
        && request.resource.data.assessmentScheduledAt == null
        && request.resource.data.assessmentResult == ''
        && request.resource.data.verifiedAt == null
        && request.resource.data.expiresAt == null
        && request.resource.data.reviewedByUid == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'userId', 'userName', 'ownerUid', 'equipmentId', 'equipmentName',
          'categoryId', 'qualificationType', 'submissionType', 'experienceDetails',
          'hasEvidence', 'evidenceName', 'evidenceMimeType', 'status',
          'reviewerNotes', 'assessmentStatus', 'assessmentScheduledAt',
          'assessmentResult', 'verifiedAt', 'expiresAt', 'reviewedByUid',
          'createdAt', 'updatedAt'
        ])
        && hasAuditAfter(
          qualificationId,
          'qualification',
          'Qualification Submitted',
          request.resource.data.ownerUid
        );

      allow update: if isOwner(resource.data.ownerUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewerNotes', 'reviewedByUid', 'updatedAt', 'verifiedAt',
          'expiresAt', 'assessmentStatus', 'assessmentScheduledAt', 'assessmentResult'
        ])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.equipmentId == resource.data.equipmentId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.reviewerNotes is string
        && request.resource.data.reviewerNotes.size() <= 2000
        && (
          (
            resource.data.status == 'Pending'
            && request.resource.data.status == 'Verified'
            && request.resource.data.verifiedAt == request.time
            && (
              resource.data.submissionType != 'assessment'
              || (
                resource.data.assessmentStatus == 'Scheduled'
                && request.resource.data.assessmentStatus == 'Passed'
              )
            )
            && (
              request.resource.data.expiresAt == null
              || (
                request.resource.data.expiresAt is timestamp
                && request.resource.data.expiresAt > request.time
              )
            )
            && hasAuditAfter(
              qualificationId,
              'qualification',
              resource.data.submissionType == 'assessment'
                ? 'Practical Assessment Passed'
                : 'Qualification Verified',
              resource.data.ownerUid
            )
          )
          || (
            resource.data.status == 'Pending'
            && request.resource.data.status == 'Rejected'
            && (
              resource.data.submissionType != 'assessment'
              || (
                resource.data.assessmentStatus == 'Scheduled'
                && request.resource.data.assessmentStatus == 'Failed'
              )
            )
            && hasAuditAfter(
              qualificationId,
              'qualification',
              resource.data.submissionType == 'assessment'
                ? 'Practical Assessment Failed'
                : 'Qualification Rejected',
              resource.data.ownerUid
            )
          )
          || (
            resource.data.status == 'Pending'
            && request.resource.data.status == 'Pending'
            && resource.data.submissionType == 'assessment'
            && request.resource.data.assessmentStatus == 'Scheduled'
            && request.resource.data.assessmentScheduledAt is timestamp
            && hasAuditAfter(
              qualificationId,
              'qualification',
              'Practical Assessment Scheduled',
              resource.data.ownerUid
            )
          )
          || (
            resource.data.status == 'Pending'
            && request.resource.data.status == 'Training Required'
            && resource.data.submissionType == 'assessment'
            && resource.data.assessmentStatus == 'Scheduled'
            && request.resource.data.assessmentStatus == 'Training Required'
            && hasAuditAfter(
              qualificationId,
              'qualification',
              'Training Required',
              resource.data.ownerUid
            )
          )
          || (
            resource.data.status == 'Verified'
            && request.resource.data.status in ['Expired', 'Revoked']
            && hasAuditAfter(
              qualificationId,
              'qualification',
              request.resource.data.status == 'Expired'
                ? 'Qualification Expired'
                : 'Qualification Revoked',
              resource.data.ownerUid
            )
          )
        );

      allow delete: if false;
    }

    match /qualificationEvidence/{qualificationId} {
      allow read: if activeAccount()
        && (
          get(qualificationPath(qualificationId)).data.userId == request.auth.uid
          || isOwner(get(qualificationPath(qualificationId)).data.ownerUid)
        );

      allow create: if activeAccount()
        && hasUserRole(profile(request.auth.uid))
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 450000
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 255
        && request.resource.data.mimeType in [
          'application/pdf', 'image/jpeg', 'image/png', 'image/webp'
        ]
        && (
          (
            request.resource.data.mimeType == 'application/pdf'
            && request.resource.data.dataUrl.matches('^data:application/pdf;base64,.*$')
          )
          || (
            request.resource.data.mimeType == 'image/jpeg'
            && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,.*$')
          )
          || (
            request.resource.data.mimeType == 'image/png'
            && request.resource.data.dataUrl.matches('^data:image/png;base64,.*$')
          )
          || (
            request.resource.data.mimeType == 'image/webp'
            && request.resource.data.dataUrl.matches('^data:image/webp;base64,.*$')
          )
        )
        && request.resource.data.keys().hasOnly([
          'userId', 'ownerUid', 'fileName', 'mimeType', 'dataUrl', 'createdAt'
        ])
        && getAfter(qualificationPath(qualificationId)).data.userId
          == request.resource.data.userId
        && getAfter(qualificationPath(qualificationId)).data.ownerUid
          == request.resource.data.ownerUid
        && getAfter(qualificationPath(qualificationId)).data.hasEvidence == true
        && getAfter(qualificationPath(qualificationId)).data.evidenceName
          == request.resource.data.fileName
        && getAfter(qualificationPath(qualificationId)).data.evidenceMimeType
          == request.resource.data.mimeType;

      allow update, delete: if false;
    }

    match /qualificationGrants/{grantId} {
      allow read: if activeAccount()
        && (resource.data.userId == request.auth.uid
          || isOwner(resource.data.ownerUid));

      allow create: if activeAccount()
        && isOwner(request.resource.data.ownerUid)
        && grantId == request.resource.data.qualificationId + '_' + request.resource.data.resourceId
        && request.resource.data.active == true
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'qualificationId', 'userId', 'ownerUid', 'resourceId', 'resourceName',
          'categoryId', 'qualificationType', 'active', 'createdAt'
        ])
        && get(qualificationPath(request.resource.data.qualificationId)).data.userId
          == request.resource.data.userId
        && get(qualificationPath(request.resource.data.qualificationId)).data.ownerUid
          == request.auth.uid
        && get(qualificationPath(request.resource.data.qualificationId)).data.status == 'Verified'
        && (
          get(qualificationPath(request.resource.data.qualificationId)).data.expiresAt == null
          || get(qualificationPath(request.resource.data.qualificationId)).data.expiresAt > request.time
        )
        && get(qualificationPath(request.resource.data.qualificationId)).data.qualificationType
          == request.resource.data.qualificationType
        && get(resourcePath(request.resource.data.resourceId)).data.ownerUid == request.auth.uid
        && get(resourcePath(request.resource.data.resourceId)).data.get('qualificationReusable', false) == true
        && effectiveQualificationType(get(resourcePath(request.resource.data.resourceId)).data)
          == request.resource.data.qualificationType
        && normalizedCategory(get(resourcePath(request.resource.data.resourceId)).data)
          == request.resource.data.categoryId
        && request.resource.data.resourceName
          == get(resourcePath(request.resource.data.resourceId)).data.name
        && hasAuditAfter(
          request.resource.data.qualificationId + '_' + request.resource.data.resourceId,
          'qualificationGrant',
          'Qualification Shared',
          request.resource.data.ownerUid
        );

      allow update, delete: if false;
    }

    match /equipmentReports/{reportId} {
      allow read: if activeAccount()
        && (resource.data.userId == request.auth.uid
          || isOwner(resource.data.ownerUid));

      allow create: if activeAccount()
        && hasUserRole(profile(request.auth.uid))
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName == profile(request.auth.uid).name
        && request.resource.data.ownerUid != request.auth.uid
        && get(resourcePath(request.resource.data.resourceId)).data.ownerUid
          == request.resource.data.ownerUid
        && get(resourcePath(request.resource.data.resourceId)).data.name
          == request.resource.data.resourceName
        && request.resource.data.status == 'Pending'
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 3000
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.photoData.size() <= 250000
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'resourceId', 'resourceName', 'ownerUid', 'userId', 'userName',
          'category', 'description', 'photoData', 'status', 'createdAt',
          'updatedAt'
        ])
        && hasAuditAfter(
          reportId,
          'equipmentReport',
          'Equipment Report Submitted',
          request.resource.data.ownerUid
        );

      allow update: if isOwner(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          (
            resource.data.status == 'Pending'
            && request.resource.data.status in ['Under Review', 'Resolved', 'Rejected']
          )
          || (
            resource.data.status == 'Under Review'
            && request.resource.data.status in ['Resolved', 'Rejected']
          )
        )
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'reviewedByUid'
        ])
        && hasAuditAfter(
          reportId,
          'equipmentReport',
          'Equipment Report Updated to ' + request.resource.data.status,
          resource.data.ownerUid
        );

      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if activeAccount()
        && (resource.data.userId == request.auth.uid
          || isOwner(resource.data.ownerUid));
      allow create: if activeAccount()
        && logId == request.resource.data.relatedId + '_' + request.resource.data.actionLabel
        && (request.resource.data.userId == request.auth.uid
          || isOwner(request.resource.data.ownerUid))
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.relatedId is string
        && request.resource.data.ownerUid is string
        && request.resource.data.userId is string
        && request.resource.data.relatedType in [
          'booking', 'equipmentReport', 'qualification', 'qualificationGrant'
        ]
        && request.resource.data.role in ['Owner', 'Borrower']
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.relatedType == 'booking'
            && getAfter(bookingPath(request.resource.data.relatedId)).data.userId
              == request.resource.data.userId
            && getAfter(bookingPath(request.resource.data.relatedId)).data.ownerUid
              == request.resource.data.ownerUid
            && validBookingAudit(
              request.resource.data.relatedId,
              request.resource.data.actionLabel
            )
          )
          || (
            request.resource.data.relatedType == 'equipmentReport'
            && getAfter(
              /databases/$(database)/documents/equipmentReports/$(request.resource.data.relatedId)
            ).data.userId == request.resource.data.userId
            && getAfter(
              /databases/$(database)/documents/equipmentReports/$(request.resource.data.relatedId)
            ).data.ownerUid == request.resource.data.ownerUid
            && validReportAudit(
              request.resource.data.relatedId,
              request.resource.data.actionLabel
            )
          )
          || (
            request.resource.data.relatedType == 'qualification'
            && getAfter(qualificationPath(request.resource.data.relatedId)).data.userId
              == request.resource.data.userId
            && getAfter(qualificationPath(request.resource.data.relatedId)).data.ownerUid
              == request.resource.data.ownerUid
            && validQualificationAudit(
              request.resource.data.relatedId,
              request.resource.data.actionLabel
            )
          )
          || (
            request.resource.data.relatedType == 'qualificationGrant'
            && getAfter(
              /databases/$(database)/documents/qualificationGrants/$(request.resource.data.relatedId)
            ).data.userId == request.resource.data.userId
            && getAfter(
              /databases/$(database)/documents/qualificationGrants/$(request.resource.data.relatedId)
            ).data.ownerUid == request.resource.data.ownerUid
            && validQualificationGrantAudit(request.resource.data.relatedId)
          )
        );
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if activeAccount() && resource.data.recipientUid == request.auth.uid;
      allow create: if activeAccount()
        && notificationId == request.resource.data.relatedId + '_' + request.resource.data.type
        && request.resource.data.recipientUid is string
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.type == 'booking-request'
            && getAfter(bookingPath(request.resource.data.relatedId)).data.userId == request.auth.uid
            && getAfter(bookingPath(request.resource.data.relatedId)).data.ownerUid
              == request.resource.data.recipientUid
          )
          || (
            request.resource.data.type in [
              'booking-cancelled', 'equipment-returned'
            ]
            && get(bookingPath(request.resource.data.relatedId)).data.userId == request.auth.uid
            && get(bookingPath(request.resource.data.relatedId)).data.ownerUid
              == request.resource.data.recipientUid
          )
          || (
            request.resource.data.type == 'equipment-report'
            && getAfter(/databases/$(database)/documents/equipmentReports/$(request.resource.data.relatedId)).data.userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/equipmentReports/$(request.resource.data.relatedId)).data.ownerUid
              == request.resource.data.recipientUid
          )
          || (
            request.resource.data.type == 'qualification-submission'
            && getAfter(qualificationPath(request.resource.data.relatedId)).data.userId
              == request.auth.uid
            && getAfter(qualificationPath(request.resource.data.relatedId)).data.ownerUid
              == request.resource.data.recipientUid
          )
          || (
            request.resource.data.type == 'qualification-shared'
            && getAfter(
              /databases/$(database)/documents/qualificationGrants/$(request.resource.data.relatedId)
            ).data.userId == request.auth.uid
            && getAfter(
              /databases/$(database)/documents/qualificationGrants/$(request.resource.data.relatedId)
            ).data.ownerUid == request.resource.data.recipientUid
          )
          || (
            request.resource.data.type in [
              'qualification-qualification-verified',
              'qualification-qualification-rejected',
              'qualification-practical-assessment-scheduled',
              'qualification-practical-assessment-passed',
              'qualification-practical-assessment-failed',
              'qualification-training-required',
              'qualification-qualification-revoked',
              'qualification-qualification-expired'
            ]
            && getAfter(qualificationPath(request.resource.data.relatedId)).data.ownerUid
              == request.auth.uid
            && getAfter(qualificationPath(request.resource.data.relatedId)).data.userId
              == request.resource.data.recipientUid
          )
        );
      allow update, delete: if false;
    }
  }
}
